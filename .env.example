# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- Profile ------------------------------------------------------------------
# dev  = creates development logins admin/Admin@1234 and operator/Operator@1234 (NEVER use at the cafe)
# prod = creates one admin from APP_BOOTSTRAP_ADMIN_* who must change the password at first login
SPRING_PROFILES_ACTIVE=dev

# --- Database -----------------------------------------------------------------
MYSQL_DATABASE=console_adda
MYSQL_USER=console_adda
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_HOST_PORT=3307

# --- Security -----------------------------------------------------------------
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_TTL=12h

# First admin account (prod profile only). Ignored once the user exists.
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# Swagger UI at http://localhost:8080/swagger-ui.html (keep false in production)
API_DOCS_ENABLED=true

# --- Ports --------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_HOST_PORT=8080
